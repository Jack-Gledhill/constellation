# /etc/rancher/k3s/config.yaml

node-name: {{ inventory_hostname_short }}
node-label: {{ kubernetes_node.labels | list }}
node-taint: {{ kubernetes_node.taints | list }}

cluster-domain: {{ kubernetes_cluster.network.domain }}
disable: {{ kubernetes_cluster.disable | list }}
disable-cloud-controller: {{ kubernetes_cluster.disable_cloud_controller }}
flannel-backend: {{ kubernetes_cluster.network.flannel_backend }}
tls-san: {{ kubernetes_cluster.network.tls_san | list }}
secrets-encryption: true
write-kubeconfig-mode: 0644

cluster-cidr: {{ kubernetes_cluster.network.pod_cidr }}
service-cidr: {{ kubernetes_cluster.network.service_cidr }}
cluster-dns: {{ kubernetes_cluster.network.cluster_dns }}

etcd-expose-metrics: true
etcd-disable-snapshots: {{ kubernetes_cluster.etcd.snapshots.disabled }}
etcd-snapshot-retention: {{ kubernetes_cluster.etcd.snapshots.retention }}
etcd-snapshot-dir: {{ kubernetes_cluster.etcd.snapshots.directory }}

etcd-s3: {{ kubernetes_cluster.etcd.s3.enabled }}
etcd-s3-access-key: {{ kubernetes_cluster.etcd.s3.access_key }}
etcd-s3-secret-key: {{ kubernetes_cluster.etcd.s3.secret_key }}
etcd-s3-bucket: {{ kubernetes_cluster.etcd.s3.bucket }}